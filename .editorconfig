
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C# - .NET
[*.cs]
indent_size = 4
tab_width = 4

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace

# Code style
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_style_prefer_top_level_statements = false:warning

# Naming conventions
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = interface_prefix

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_symbols.interfaces.required_modifiers =

dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.interface_prefix.capitalization = pascal_case

# .NET analyzers
dotnet_analyzer_diagnostic.severity = warning

# Project files
[*.{csproj,props,targets}]
indent_size = 2

# Python - PEP 8
[*.py]
indent_size = 4
tab_width = 4
max_line_length = 88

# JavaScript / TypeScript / React
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
tab_width = 2

# JSON
[*.json]
indent_size = 2
tab_width = 2

# JSON with comments
[*.jsonc]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2
tab_width = 2

# SQL
[*.sql]
indent_size = 4
tab_width = 4

# XML / HTML
[*.{xml,html,cshtml}]
indent_size = 2

# CSS / SCSS
[*.{css,scss}]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# TOML
[*.toml]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 4

# Docker Compose
[docker-compose*.yml]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
